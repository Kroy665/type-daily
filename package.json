{
  "name": "type-daily",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "seed": "prisma db seed",
    "add-texts": "ts-node -O '{\"module\":\"CommonJS\"}' scripts/add-sample-texts.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.16.2",
    "chart.js": "^4.4.3",
    "next": "^15.5.25",
    "next-auth": "^4.24.7",
    "react": "^18",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "prisma": "^5.16.2",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "postcss": "^8.5.28",
    "uuid": "^11.1.1",
    "nanoid": "^3.3.19",
    "picomatch": "^4.0.4",
    "brace-expansion": "^2.0.7",
    "postcss-selector-parser": "^6.1.3",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
